{
  "name": "stand-der-technik-radar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && node scripts/check-data.mjs && vite build && node scripts/check-build.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:data": "node scripts/check-data.mjs",
    "check": "npm run lint && npm run format:check && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@kern-ux/native": "2.8.2",
    "d3-hierarchy": "3.1.2",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.8",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "@playwright/test": "1.63.0",
    "vitest": "5.0.3",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.2",
    "@eslint/js": "10.0.1",
    "globals": "16.5.0",
    "prettier": "3.9.9",
    "@types/node": "22.20.5"
  },
  "description": "KERN-basierte Recherche in Taxonomie und BSI-Trendanalysen",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BSI-Bund/Stand-der-Technik-Radar.git"
  },
  "homepage": "https://bsi-bund.github.io/Stand-der-Technik-Radar/"
}
